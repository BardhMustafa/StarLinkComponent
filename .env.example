# Copy to .env.local for development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Public origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.starlinkcomponents.com

# --- RFQ email (Resend) -------------------------------------------------------
# API key from https://resend.com/api-keys. Without it, RFQ submissions are
# validated and logged on the server but no email is sent.
RESEND_API_KEY=
# Inbox that receives RFQs.
RFQ_TO_EMAIL=sales@starlinkcomponents.com
# Sender address. Must be on a domain verified in Resend (SPF + DKIM).
# Until starlinkcomponents.com is verified, use Resend's test sender:
RFQ_FROM_EMAIL="StarLink Components <onboarding@resend.dev>"

# --- Rate limiting (Upstash Redis) ---------------------------------------------
# From the Upstash console (or the Vercel Marketplace integration). When unset,
# a per-instance in-memory limiter is used, which is fine for local dev only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
